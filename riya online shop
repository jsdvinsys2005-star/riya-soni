<!DOCTYPE html>
<html>
<head>
<title>My Online Shop</title>
<link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <h1>riya Online Shop</h1>
    <button onclick="showCart()">Cart 🛒 (<span id="count">0</span>)</button>
</header>

<div class="products">

<div class="card">
    <h2>T-Shirt</h2>
    <p>₹499</p>
    <button onclick="addToCart('T-Shirt',499)">Add Cart</button>
</div>

<div class="card">
    <h2>Shoes</h2>
    <p>₹999</p>
    <button onclick="addToCart('Shoes',999)">Add Cart</button>
</div>

<div class="card">
    <h2>Watch</h2>
    <p>₹799</p>
    <button onclick="addToCart('Watch',799)">Add Cart</button>
</div>

</div>

<div id="cart"></div>

<script src="script.js"></script>

</body>
</html>
